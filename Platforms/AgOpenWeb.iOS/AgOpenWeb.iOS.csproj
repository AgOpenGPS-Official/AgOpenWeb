<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <MtouchLink>None</MtouchLink>
    <ApplicationId>com.agopenweb.ios</ApplicationId>
    <ApplicationTitle>AgOpenWeb</ApplicationTitle>
    <!-- CFBundleShortVersionString (marketing) / CFBundleVersion (build). Bump
         ApplicationVersion on every TestFlight upload; it must strictly increase. -->
    <ApplicationDisplayVersion>26.7.0</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
  </PropertyGroup>

  <!-- Simulator builds (the CI compile check and the local simulator loop) run on the
       interpreter: no AOT step, which took 6 of the 7-9 minutes of the CI job on a 3-core
       runner (63 s locally). Device builds (ios-arm64) keep AOT, which Apple requires. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <MtouchInterpreter>all</MtouchInterpreter>
  </PropertyGroup>

  <!-- iOS Device Signing Configuration -->
  <!-- Debug → on-device development (Apple Development cert). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('ios-')) and '$(Configuration)' == 'Debug'">
    <CodesignKey>Apple Development</CodesignKey>
    <CodesignProvision>Automatic</CodesignProvision>
    <DevTeam>7LRC55SQS3</DevTeam>
  </PropertyGroup>
  <!-- Release → App Store / TestFlight archive (Apple Distribution cert + App Store profile). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('ios-')) and '$(Configuration)' == 'Release'">
    <CodesignKey>Apple Distribution</CodesignKey>
    <CodesignProvision>AgOpenWeb iOS App Store</CodesignProvision>
    <DevTeam>7LRC55SQS3</DevTeam>
  </PropertyGroup>

  <!-- App icon asset catalog (actool). XSAppIconAssets in Info.plist points the
       build at the AppIcon set within it. -->
  <ItemGroup>
    <ImageAsset Include="Assets.xcassets\**\*.png" />
    <ImageAsset Include="Assets.xcassets\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="Resources\LaunchScreen.storyboard" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native libSkiaSharp for the server's imagery work (same version as RemoteServer's
         SkiaSharp). -->
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="3.119.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Models\AgOpenWeb.Models.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Services\AgOpenWeb.Services.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.ViewModels\AgOpenWeb.ViewModels.csproj" />
    <!-- All-in-one host: the embedded web server (now ASP.NET-free, so iOS-
         referenceable) + the shared web-command wiring. -->
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteServer\AgOpenWeb.RemoteServer.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteWiring\AgOpenWeb.RemoteWiring.csproj" />
  </ItemGroup>

</Project>
