<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ISOBUS virtual terminal behind the web client's VT card: IVirtualTerminalService over
    AgIsoStack-dotnet's VirtualTerminal and AowLink. That library is not published yet, so this
    project builds only with AgIsoStackDir naming a checkout of it (an absolute path), and a head
    references it only then:
      dotnet run -p:AgIsoStackDir=$HOME/Code/AgIsoStack-dotnet ...
    It is not in AgOpenWeb.sln. Desktop only for now (the library's iOS and Android builds come
    later); a head without it registers no terminal and the card never shows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgOpenWeb.Services\AgOpenWeb.Services.csproj" />
    <ProjectReference Include="$(AgIsoStackDir)/dotnet/AgIsoStack.VirtualTerminal/AgIsoStack.VirtualTerminal.csproj"
                      AdditionalProperties="DesktopOnly=true" />
  </ItemGroup>

</Project>
