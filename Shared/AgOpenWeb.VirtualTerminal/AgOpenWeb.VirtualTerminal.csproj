<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ISOBUS virtual terminal behind the web client's VT card: IVirtualTerminalService over
    SharpIsoTerm's VirtualTerminal and AowLink. SharpIsoTerm comes as its NuGet package from its
    GitHub release (https://github.com/chriskinal/SharpIsoTerm/releases), pinned below by version
    and SHA-256: FetchSharpIsoTerm downloads it into nuget-local/ (a package source, nuget.config)
    during restore, so a plain build needs nothing else. The package has every native library
    (desktop under runtimes/, Android in its .aar, iOS linked by its buildTransitive/ targets). To
    take a new SharpIsoTerm, change both properties to its release's.
    Working on SharpIsoTerm itself: build against a checkout of it instead (an absolute path),
      dotnet run -p:SharpIsoTermDir=$HOME/Code/SharpIsoTerm ...
    which needs its native libraries built (its native/build.sh).
  -->
  <PropertyGroup>
    <!-- net10.0, and each mobile target whose workload is installed (its reference pack is there):
         a head must take the package's assembly and native libraries for its own platform, so the
         Android head gets net10.0-android wherever it builds (CI and the nightly: on Linux), and a
         machine without a workload need not have it. -p:DesktopOnly=true: net10.0 only. -->
    <_VtPacks>$(NetCoreTargetingPackRoot)</_VtPacks>
    <_VtAndroid Condition="'$(DesktopOnly)' != 'true' And Exists('$(_VtPacks)') And '$([System.IO.Directory]::GetDirectories(`$(_VtPacks)`, `Microsoft.Android.Ref.*`))' != ''">;net10.0-android</_VtAndroid>
    <_VtIos Condition="'$(DesktopOnly)' != 'true' And Exists('$(_VtPacks)') And '$([System.IO.Directory]::GetDirectories(`$(_VtPacks)`, `Microsoft.iOS.Ref.*`))' != ''">;net10.0-ios</_VtIos>
    <TargetFrameworks>net10.0$(_VtAndroid)$(_VtIos)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgOpenWeb.Services\AgOpenWeb.Services.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SharpIsoTermVersion>0.1.1</SharpIsoTermVersion>
    <SharpIsoTermSha256>342454bddd69a8bbab3236953a02b7689482c486f17bac3a3ff066882673d553</SharpIsoTermSha256>
    <SharpIsoTermFeed>$(MSBuildThisFileDirectory)../../nuget-local/</SharpIsoTermFeed>
    <SharpIsoTermPackage>$(SharpIsoTermFeed)SharpIsoTerm.$(SharpIsoTermVersion).nupkg</SharpIsoTermPackage>
  </PropertyGroup>
  <ItemGroup Condition="'$(SharpIsoTermDir)' == ''">
    <PackageReference Include="SharpIsoTerm" Version="$(SharpIsoTermVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpIsoTermDir)' != ''">
    <!-- The desktop build takes only the library's desktop target (no mobile workloads needed). -->
    <ProjectReference Include="$(SharpIsoTermDir)/dotnet/SharpIsoTerm/SharpIsoTerm.csproj"
                      AdditionalProperties="DesktopOnly=true" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="$(SharpIsoTermDir)/dotnet/SharpIsoTerm/SharpIsoTerm.csproj"
                      Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>

  <!-- The package, fetched once (restore collects the package references after this) and checked
       against its SHA-256; a file that does not match is deleted and the build stops. Each run
       downloads to a file of its own, so two restores side by side cannot mix theirs. -->
  <Target Name="FetchSharpIsoTerm" BeforeTargets="CollectPackageReferences"
          Condition="'$(SharpIsoTermDir)' == '' And !Exists('$(SharpIsoTermPackage)')">
    <PropertyGroup>
      <_SharpIsoTermPart>$(SharpIsoTermPackage).$([System.Guid]::NewGuid().ToString('N')).part</_SharpIsoTermPart>
    </PropertyGroup>
    <DownloadFile SourceUrl="https://github.com/chriskinal/SharpIsoTerm/releases/download/v$(SharpIsoTermVersion)/SharpIsoTerm.$(SharpIsoTermVersion).nupkg"
                  DestinationFolder="$(SharpIsoTermFeed)" DestinationFileName="$([System.IO.Path]::GetFileName($(_SharpIsoTermPart)))" Retries="3" />
    <GetFileHash Files="$(_SharpIsoTermPart)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_SharpIsoTermHash" />
    </GetFileHash>
    <Delete Files="$(_SharpIsoTermPart)" Condition="'$(_SharpIsoTermHash)' != '$(SharpIsoTermSha256)'" />
    <Error Condition="'$(_SharpIsoTermHash)' != '$(SharpIsoTermSha256)'"
           Text="SharpIsoTerm $(SharpIsoTermVersion): the downloaded package's SHA-256 is $(_SharpIsoTermHash), not $(SharpIsoTermSha256) as pinned in $(MSBuildThisFileFullPath)." />
    <Move SourceFiles="$(_SharpIsoTermPart)" DestinationFiles="$(SharpIsoTermPackage)" />
  </Target>

</Project>
