<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Update and settings-survival scenario harness: a season's worth of settings, profiles,
    fields, tracks, flags and jobs is made on an OLDER AgOpenWeb release (its Linux daemon
    bundle from the GitHub release, run headless in a child process and driven over its own
    WebSocket as a browser would), then THIS build boots in-process on the same data folder,
    as an update in place does, and everything is read back and compared. The same farm is
    also made on this build and read back after a plain restart, a crash, a corrupt settings
    file, a moved data folder, a comma-decimal locale and an AgOpenGPS field folder dropped in.
    Real time (a few minutes), so every test is [Category("Scenario")]. See README.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Models\AgOpenWeb.Models.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Services\AgOpenWeb.Services.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.ViewModels\AgOpenWeb.ViewModels.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteServer\AgOpenWeb.RemoteServer.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteWiring\AgOpenWeb.RemoteWiring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <None Update="KnownFindings.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stops the run when another process holds the module ports (Tests/ScenarioShared). -->
    <Compile Include="..\ScenarioShared\PortGuard.cs" Link="PortGuard.cs" />
    <Compile Include="..\ScenarioShared\ReportPath.cs" Link="ReportPath.cs" />
  </ItemGroup>

</Project>
