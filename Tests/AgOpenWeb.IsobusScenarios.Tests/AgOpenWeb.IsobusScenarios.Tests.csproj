<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ISOBUS scenario harness: boots the real backend in-process (every service real, its real
    UDP service on port 9999, a temp data folder, no browser) with an emulated AOG-TaskController
    on 127.0.0.1:8888 (PGN 240 heartbeats with an implement's actual sections, PGN 221 messages,
    PGN 229 / 241 / 242 / 214 taken as the real one takes them) and the implements on its bus.
    A careful operator works a day with a sprayer and a planter in automatic section control; a
    careless one starts things in the wrong order, meets a task controller that refuses, a mode
    changed on the terminal, restarts, dropped links, bad frames, 64 sections, two implements.
    The harness compares the screen's sections with the implement's every 100 ms. Real time
    (a few minutes), so every test is [Category("Scenario")]. See README.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Models\AgOpenWeb.Models.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Services\AgOpenWeb.Services.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.ViewModels\AgOpenWeb.ViewModels.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteServer\AgOpenWeb.RemoteServer.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteWiring\AgOpenWeb.RemoteWiring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stops the run when another process holds the module ports (Tests/ScenarioShared). -->
    <Compile Include="..\ScenarioShared\PortGuard.cs" Link="PortGuard.cs" />
    <Compile Include="..\ScenarioShared\ReportPath.cs" Link="ReportPath.cs" />
  </ItemGroup>

</Project>
