<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dump-replay scenario harness: boots the real backend in-process (every service real, its
    real UDP service on port 9999, a temporary data folder, no browser), loads a bug report
    dump (the reporter's settings, field, track, job and coverage) and drives the GPS pipeline
    from the dump's GPS log, at the log's own pace. Each dump is then taken over from the
    reporter's position by a simulated machine that AgOpenWeb steers. The harness compares what
    AgOpenWeb does now with what it did for the reporter, and checks the run against the
    field and field job rules. Real time (minutes per dump), so every test is
    [Category("Scenario")]. See README.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Models\AgOpenWeb.Models.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.Services\AgOpenWeb.Services.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.ViewModels\AgOpenWeb.ViewModels.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteServer\AgOpenWeb.RemoteServer.csproj" />
    <ProjectReference Include="..\..\Shared\AgOpenWeb.RemoteWiring\AgOpenWeb.RemoteWiring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stops the run when another process holds the module ports (Tests/ScenarioShared). -->
    <Compile Include="..\ScenarioShared\PortGuard.cs" Link="PortGuard.cs" />
    <Compile Include="..\ScenarioShared\ReportPath.cs" Link="ReportPath.cs" />
  </ItemGroup>

</Project>
