<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org, and nuget-local/: packages from GitHub releases that the build fetches itself
       (SharpIsoTerm; see Shared/AgOpenWeb.VirtualTerminal). -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="nuget-local" value="nuget-local" />
  </packageSources>
</configuration>
