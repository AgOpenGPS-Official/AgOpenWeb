root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4

[*.{xml,xaml,axaml,csproj,sln,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Globalization / culture-correctness rules.
#
# CA1305 fires anywhere a culture-sensitive ToString / Parse / interpolated
# string is used without an explicit IFormatProvider. Anything that lands on
# disk, on the wire or in the web client MUST use InvariantCulture (see the
# Field.txt fi-FI regression that prompted this); display-only code may pass
# CurrentCulture explicitly. Either way the provider is written down, so the
# rule is an error for all production code - a new persistence sink needs no
# .editorconfig entry to be covered.
#
# The other globalization rules (CA1303 localization, CA1307/CA1310 string
# comparison, CA1308 upper/lower normalization) are stylistic for this
# project - silenced so only the IFormatProvider rule shows up.
[*.cs]
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1308.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none

# Tests parse and format literals in the test culture; nothing reaches disk or wire.
[Tests/**/*.cs]
dotnet_diagnostic.CA1305.severity = none

# The iOS head only compiles in CI after merge; keep it a warning until that run is green.
[Platforms/AgOpenWeb.iOS/**/*.cs]
dotnet_diagnostic.CA1305.severity = warning

# Generated files: skip culture rules entirely.
[**/{obj,bin}/**]
generated_code = true
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
